ErrorDocument 401 /errors/401.php
ErrorDocument 404 /errors/404.php
ErrorDocument 403 /errors/403.php

# Increase both values below for uploading bigger files
php_value upload_max_filesize 50M
php_value post_max_size 52M
# End Increase files

####################

php_flag display_errors off

Options -Indexes

<FilesMatch "(?i)\.(log|sql|json|bak|md|txt|ini|sh|csv)$|^config\.php\.bak|^\.(git|ht)">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/(_logs|_tmp|dumps|var|install|_include|_templates)(/|$)
