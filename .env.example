# Copier en .env puis adapter
TZ=Europe/Paris

# Port HTTP exposé sur l'hôte
OKV_PORT=8080

# Base de données (à reporter dans setup.php : hôte = db)
DB_NAME=okovision
DB_USER=okouser
DB_PASSWORD=okopass
DB_ROOT_PASSWORD=change-me-root

# --- Dev uniquement (docker-compose.override.yml)
# Port MariaDB exposé sur l'hôte
DB_PORT=3306
# 1 = installe Xdebug (port 9003) au build
INSTALL_XDEBUG=0
# 1 = active le cron dans le conteneur de dev
OKV_CRON_DEV=0
